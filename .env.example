# Anthropic API key (get one at https://console.anthropic.com, billing must be enabled)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for analyst memo generation. claude-opus-4-8 (default) for best quality;
# claude-sonnet-4-6 is a cheaper alternative if you scale up to heavy daily use.
ANTHROPIC_MODEL=claude-opus-4-8

# SEC requires a descriptive User-Agent with a real contact email on every request.
SEC_USER_AGENT=SEC8KMonitor your-email@example.com

# Local dev defaults to a SQLite file; in production this is set to the Render Postgres URL.
DATABASE_URL=sqlite:///./sec8k.db

# How often the background refresh job pulls new filings, in hours.
REFRESH_INTERVAL_HOURS=3

# Secret token required to call POST /admin/refresh manually. Make this a long random string.
ADMIN_TOKEN=change-me-to-a-random-string
